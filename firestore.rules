rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function userExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return userExists() &&
        (role() == "admin" || role() == "Admin");
    }

    function isFaculty() {
      return userExists() &&
        (role() == "faculty" || role() == "Faculty");
    }

    function isStudent() {
      return userExists() &&
        (role() == "student" || role() == "Student");
    }

    function isMember() {
      return userExists() &&
        (role() == "member" || role() == "Member");
    }

    match /users/{userId} {
      allow read:
        if signedIn();

      allow create:
        if signedIn() &&
        request.auth.uid == userId &&
        (
          !request.resource.data.keys().hasAll(['role']) ||
          request.resource.data.role == 'student' ||
          (request.resource.data.role == 'admin' && request.resource.data.email.lower() in ['tapadarhribhu@gmail.com', 'biswa.maity2011@gmail.com']) ||
          (request.resource.data.role == 'faculty' && request.resource.data.email.lower() in ['sharmisthaghosh855@gmail.com', 'tapadarhribhu350@gmail.com']) ||
          (request.resource.data.role == 'member' && request.resource.data.email.lower() in ['piyali0903@gmail.com'])
        ) &&
        (
          (request.resource.data.keys().hasAll(['role']) && request.resource.data.role == 'student') ||
          !request.resource.data.keys().hasAny(['studentId', 'studentGroup', 'feeStatus', 'feesAmount', 'paidAmount', 'pendingAmount', 'assignedStudentIds'])
        );

      allow update:
        if signedIn() &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedFacultyIds', 'assignedFaculty']) &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['feesAmount', 'paidAmount', 'pendingAmount', 'feeStatus']) ||
              (
                exists(/databases/$(database)/documents/fees/$(userId)) &&
                request.resource.data.feesAmount == get(/databases/$(database)/documents/fees/$(userId)).data.totalFeeDue &&
                request.resource.data.paidAmount == get(/databases/$(database)/documents/fees/$(userId)).data.totalPaid &&
                request.resource.data.pendingAmount == get(/databases/$(database)/documents/fees/$(userId)).data.remainingBalance &&
                request.resource.data.feeStatus == get(/databases/$(database)/documents/fees/$(userId)).data.status
              )
            ) &&
            (
              !resource.data.keys().hasAll(['studentGroup']) ||
              resource.data.studentGroup == '' ||
              resource.data.studentGroup == null ||
              request.resource.data.studentGroup == resource.data.studentGroup
            )
          )
        ) &&
        (
          (request.resource.data.keys().hasAll(['role']) && request.resource.data.role == 'student') ||
          !request.resource.data.keys().hasAny(['studentId', 'studentGroup', 'feeStatus', 'feesAmount', 'paidAmount', 'pendingAmount', 'assignedStudentIds'])
        );

      allow delete:
        if isAdmin();

      // Subcollections inside user document (notes, progress, attendance, fees, assignments, chatHistory, notifications)
      match /{allSubcollections=**} {
        allow read, write:
          if signedIn() &&
          (
            request.auth.uid == userId
            || isAdmin()
            || isFaculty()
          );
      }
    }

    match /facultyAssignments/{facultyId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /studentFacultyMap/{studentId} {
      allow read:
        if signedIn() &&
        (
          request.auth.uid == studentId
          || isAdmin()
          || isFaculty()
        );

      allow write:
        if isAdmin() || isFaculty();
    }

    match /facultyStudentRoster/{facultyUid} {
      allow read, write:
        if signedIn() &&
        (
          isAdmin() ||
          (isFaculty() && request.auth.uid == facultyUid)
        );
    }

    match /calendarEvents/{eventId} {
      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin() || isFaculty();
    }

    match /attendance/{attendanceId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /community/{postId} {
      allow read:
        if signedIn();

      allow create:
        if isAdmin() || isFaculty() || isStudent();

      allow update, delete:
        if isAdmin()
        || isFaculty()
        || (signedIn() && request.auth.uid == resource.data.authorId);
    }

    // Support both communityPosts and community collection mappings
    match /communityPosts/{postId} {
      allow read:
        if signedIn();

      allow create:
        if isAdmin() || isFaculty() || isStudent();

      allow update, delete:
        if isAdmin()
        || isFaculty()
        || (signedIn() && request.auth.uid == resource.data.authorId);
    }

    match /privateChats/{chatId} {
      allow read, write:
        if signedIn();
    }

    match /notices/{noticeId} {
      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin() || isFaculty() || isStudent();
    }

    // Additional collections in use by Compution platform
    match /communityThreads/{threadId} {
      allow read, write:
        if signedIn();

      match /messages/{messageId} {
        allow read, write:
          if signedIn();
      }
    }

    match /chatRooms/{roomId} {
      allow read, write:
        if signedIn();

      match /messages/{messageId} {
        allow read, write:
          if signedIn();
      }
    }

    match /courses/{courseId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /tests/{testId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /rescheduleRequests/{requestId} {
      allow read:
        if signedIn();

      allow create:
        if signedIn();

      allow update, delete:
        if isAdmin() || isFaculty();
    }

    match /paymentHistory/{paymentId} {
      allow read:
        if signedIn() &&
        (
          request.auth.uid == resource.data.studentId
          || isAdmin()
        );

      allow write:
        if isAdmin();
    }

    match /parentContacts/{contactId} {
      allow read:
        if signedIn() &&
        (
          isAdmin() ||
          isFaculty() ||
          resource.data.studentId == request.auth.uid
        );

      allow write:
        if isAdmin() || isFaculty();
    }

    match /staff/{staffId} {
      allow read:
        if true; // Public page reads staff directory

      allow write:
        if isAdmin();
    }

    match /assignedFaculty/{id} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /studentCalendar/{id} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /studentSchedules/{id} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /meetSessions/{id} {
      allow read:
        if signedIn();

      allow write:
        if isMember() || isAdmin() || isFaculty();
    }

    match /notificationHistory/{id} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /attendanceNotifications/{id} {
      allow read, write:
        if isAdmin() || isFaculty();
    }

    match /testAttempts/{attemptId} {
      allow read:
        if signedIn();

      allow create:
        if signedIn() && request.auth.uid == request.resource.data.studentId;

      allow update:
        if signedIn();

      allow delete:
        if isAdmin() || isFaculty();
    }

    match /leaderboards/{leaderboardId} {
      allow read:
        if signedIn();

      allow write:
        if signedIn();
    }

    match /games/{gameId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin();
    }

    match /gameAttempts/{attemptId} {
      allow read:
        if signedIn();

      allow create:
        if signedIn() && request.auth.uid == request.resource.data.userId;

      allow update, delete:
        if isAdmin() || isFaculty();
    }

    match /userPreferences/{userId} {
      allow read, write:
        if signedIn() && request.auth.uid == userId;
    }

    match /leadCaptures/{leadId} {
      allow create:
        if true;
      allow read, update, delete:
        if isAdmin() || isMember();
    }

    match /testimonials/{testimonialId} {
      allow read:
        if true;
      allow write:
        if isAdmin();
    }

    match /facultyQueries/{queryId} {
      allow read:
        if signedIn();
      allow create:
        if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update:
        if signedIn() && (request.auth.uid == resource.data.facultyId || request.auth.uid == resource.data.studentId || isAdmin());
      allow delete:
        if isAdmin();
    }

    match /mail/{mailId} {
      allow create:
        if signedIn();
      allow read, update, delete:
        if isAdmin();
    }

    match /fees/{studentId} {
      allow read:
        if signedIn() && (request.auth.uid == studentId || isAdmin() || isFaculty());

      allow create:
        if isAdmin() || (
          signedIn() && request.auth.uid == studentId &&
          request.resource.data.paymentHistory.size() == 0
        );

      allow update:
        if isAdmin() || (
          signedIn() && request.auth.uid == studentId &&
          (!resource.exists || request.resource.data.paymentHistory == resource.data.paymentHistory)
        );

      allow delete:
        if isAdmin();
    }

    match /paymentRequests/{requestId} {
      allow create:
        if signedIn() && request.resource.data.studentId == request.auth.uid;

      allow read, update, delete:
        if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow create:
        if true;

      allow read, update, delete:
        if isAdmin() || isMember();
    }
  }
}
