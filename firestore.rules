rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function userExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return userExists() &&
        (role() == "admin" || role() == "Admin");
    }

    function isFaculty() {
      return userExists() &&
        (role() == "faculty" || role() == "Faculty");
    }

    function isStudent() {
      return userExists() &&
        (role() == "student" || role() == "Student");
    }

    function isMember() {
      return userExists() &&
        (role() == "member" || role() == "Member");
    }

    match /users/{userId} {
      allow read:
        if signedIn();

      allow create:
        if signedIn() &&
        request.auth.uid == userId &&
        (
          !request.resource.data.keys().hasAll(['role']) ||
          request.resource.data.role == 'student' ||
          (request.resource.data.role == 'admin' && request.resource.data.email.lower() in ['tapadarhribhu@gmail.com', 'biswa.maity2011@gmail.com']) ||
          (request.resource.data.role == 'faculty' && request.resource.data.email.lower() in ['sharmisthaghosh855@gmail.com', 'tapadarhribhu350@gmail.com']) ||
          (request.resource.data.role == 'member' && request.resource.data.email.lower() in ['piyali0903@gmail.com'])
        );

      allow update:
        if signedIn() &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedFacultyIds', 'assignedFaculty', 'feesAmount', 'paidAmount', 'pendingAmount', 'feeStatus']) &&
            (
              !resource.data.keys().hasAll(['studentGroup']) ||
              resource.data.studentGroup == '' ||
              resource.data.studentGroup == null ||
              request.resource.data.studentGroup == resource.data.studentGroup
            )
          )
        );

      allow delete:
        if isAdmin();

      // Subcollections inside user document (notes, progress, attendance, fees, assignments, chatHistory, notifications)
      match /{allSubcollections=**} {
        allow read, write:
          if signedIn() &&
          (
            request.auth.uid == userId
            || isAdmin()
            || isFaculty()
          );
      }
    }

    match /facultyAssignments/{facultyId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /studentFacultyMap/{studentId} {
      allow read:
        if signedIn() &&
        (
          request.auth.uid == studentId
          || isAdmin()
          || isFaculty()
        );

      allow write:
        if isAdmin() || isFaculty();
    }

    match /calendarEvents/{eventId} {
      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin() || isFaculty();
    }

    match /attendance/{attendanceId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /community/{postId} {
      allow read:
        if signedIn();

      allow create:
        if isAdmin() || isFaculty() || isStudent();

      allow update, delete:
        if isAdmin()
        || isFaculty()
        || (signedIn() && request.auth.uid == resource.data.authorId);
    }

    // Support both communityPosts and community collection mappings
    match /communityPosts/{postId} {
      allow read:
        if signedIn();

      allow create:
        if isAdmin() || isFaculty() || isStudent();

      allow update, delete:
        if isAdmin()
        || isFaculty()
        || (signedIn() && request.auth.uid == resource.data.authorId);
    }

    match /privateChats/{chatId} {
      allow read, write:
        if signedIn();
    }

    match /notices/{noticeId} {
      allow read:
        if signedIn();

      allow create, update, delete:
        if isAdmin() || isFaculty() || isStudent();
    }

    // Additional collections in use by Compution platform
    match /communityThreads/{threadId} {
      allow read, write:
        if signedIn();

      match /messages/{messageId} {
        allow read, write:
          if signedIn();
      }
    }

    match /chatRooms/{roomId} {
      allow read, write:
        if signedIn();

      match /messages/{messageId} {
        allow read, write:
          if signedIn();
      }
    }

    match /courses/{courseId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /tests/{testId} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /rescheduleRequests/{requestId} {
      allow read:
        if signedIn();

      allow create:
        if signedIn();

      allow update, delete:
        if isAdmin() || isFaculty();
    }

    match /paymentHistory/{paymentId} {
      allow read:
        if signedIn() &&
        (
          request.auth.uid == resource.data.studentId
          || isAdmin()
        );

      allow write:
        if isAdmin();
    }

    match /parentContacts/{contactId} {
      allow read:
        if signedIn() &&
        (
          isAdmin() ||
          isFaculty() ||
          resource.data.studentId == request.auth.uid
        );

      allow write:
        if isAdmin() || isFaculty();
    }

    match /staff/{staffId} {
      allow read:
        if true; // Public page reads staff directory

      allow write:
        if isAdmin();
    }

    match /assignedFaculty/{id} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /studentCalendar/{id} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /studentSchedules/{id} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /meetSessions/{id} {
      allow read:
        if signedIn();

      allow write:
        if isMember() || isAdmin() || isFaculty();
    }

    match /notificationHistory/{id} {
      allow read:
        if signedIn();

      allow write:
        if isAdmin() || isFaculty();
    }

    match /attendanceNotifications/{id} {
      allow read, write:
        if isAdmin() || isFaculty();
    }
  }
}
